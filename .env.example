# NeedRadar Environment Configuration
PROJECT_NAME="NeedRadar"
SECRET_KEY="needradar-super-secure-production-ready-jwt-secret-key-32chars-min"
DATABASE_URL="sqlite:///./needradar.db" # or postgresql://needradar:needradar_secure_pass@localhost:5432/needradar
DEFAULT_CITY="Bengaluru"
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946

# AI Engine configuration
AI_PROVIDER="deterministic" # 'deterministic' (free, offline, rule-based), 'openai', or 'gemini'
AI_API_KEY=""

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
